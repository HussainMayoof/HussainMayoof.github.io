---
import { getCollection } from 'astro:content';
import {
    getEntriesWithContent,
    sortEntriesByTime,
} from '../../utils/entryHelper.ts';
import EducationCard from './EducationCard.astro';

const { background } = Astro.props;

// Load collection entries
const educationEntries = await getCollection('education');

const sortedEducationEntries = sortEntriesByTime(educationEntries, 'startDate');
const entriesWithContent = await Promise.all(
    getEntriesWithContent(sortedEducationEntries)
);
---

<section id="education" class={`py-20 px-4 ${background}`}>
    <div class="mx-auto max-w-4xl">
        <div class="text-center mb-12">
            <h2 class="text-4xl font-bold">Education</h2>
        </div>

        <ul class="list bg-base-100 rounded-box shadow-lg">
            {
                entriesWithContent.map(({ entry, Content }) => (
                    <EducationCard entryData={entry.data} Content={Content} />
                ))
            }
        </ul>
    </div>
</section>
