---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects/Projects.astro';
import Blog from '../components/Blog/Blog.astro';
import Hackathons from '../components/Hackathons.astro';
import Contact from '../components/Contact.astro';
import { getEntry } from 'astro:content';
import Skills from '../components/Skills/Skills.astro';
import Certificates from '../components/Certificates/Certificates.astro';
import Volunteering from '../components/Volunteering.astro';
import Work from '../components/Work/Work.astro';
import Education from '../components/Education/Education.astro';

// Load Hero singleton
const heroEntry = await getEntry('hero', 'index');
if (!heroEntry) {
    throw new Error('Hero entry not found');
}

// Load General singleton
const generalEntry = await getEntry('general', 'index');
if (!generalEntry) {
    throw new Error('General entry not found');
}
const general = generalEntry.data;

const sections = [
    { Component: Skills, show: general.showSkillsSection },
    { Component: Projects, show: general.showProjectsSection },
    { Component: Blog, show: general.showBlogSection },
    { Component: Work, show: general.showWorkSection },
    { Component: Education, show: general.showEducationSection },
    { Component: Certificates, show: general.showCertificatesSection },
    { Component: Hackathons, show: general.showHackathonsSection },
    { Component: Volunteering, show: general.showVolunteeringSection },
    { Component: Contact, show: general.showContactSection },
].filter((s) => s.show);
---

<Layout
    title={`${heroEntry.data.name}`}
    description={heroEntry.data.description}
>
    <main>
        <!-- Hero Section (Always visible) -->
        <Hero hero={heroEntry.data} />

        {
            sections.map(({ Component }, i) => (
                <Component
                    background={i % 2 === 0 ? 'bg-base-300' : 'bg-base-200'}
                />
            ))
        }
    </main>
</Layout>
