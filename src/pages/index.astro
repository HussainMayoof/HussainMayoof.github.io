---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import Projects from '../components/Projects.astro';
import Blog from '../components/Blog.astro';
import Hackathons from '../components/Hackathons.astro';
import Contact from '../components/Contact.astro';
import { Briefcase, GraduationCap } from '@lucide/astro';
import { getEntry } from 'astro:content';
import Skills from '../components/Skills.astro';
import Certificates from '../components/Certificates.astro';
import Volunteering from '../components/Volunteering.astro';

// Load Hero singleton
const heroEntry = await getEntry('hero', 'index');
if (!heroEntry) {
    throw new Error('Hero entry not found');
}

// Load General singleton
const generalEntry = await getEntry('general', 'index');
if (!generalEntry) {
    throw new Error('General entry not found');
}
const general = generalEntry.data;
---

<Layout
    title={`${heroEntry.data.name}`}
    description={heroEntry.data.description}
>
    <main>
        <!-- Hero Section (Always visible) -->
        <Hero hero={heroEntry.data} />

        <!-- Skills Section -->
        {general.showSkillsSection && <Skills />}

        <!-- Projects Section -->
        {general.showProjectsSection && <Projects />}

        <!-- Blog Section -->
        {general.showBlogSection && <Blog />}

        <!-- Work Experience Section -->
        {
            general.showWorkSection && (
                <Timeline
                    collection="work"
                    variant="timeline"
                    color="primary"
                    backgroundColor="base-300"
                    icon={Briefcase}
                    sectionTitle="Work Experience"
                />
            )
        }

        <!-- Education Section -->
        {
            general.showEducationSection && (
                <Timeline
                    collection="education"
                    variant="list"
                    color="secondary"
                    backgroundColor="base-200"
                    icon={GraduationCap}
                    sectionTitle="Education"
                />
            )
        }

        <!-- Certificates Section -->
        {general.showCertificatesSection && <Certificates />}

        <!-- Hackathons Section -->
        {general.showHackathonsSection && <Hackathons />}

        <!-- Volunteering Section -->
        {general.showVolunteeringSection && <Volunteering />}

        <!-- Contact Section -->
        {general.showContactSection && <Contact />}
    </main>
</Layout>
